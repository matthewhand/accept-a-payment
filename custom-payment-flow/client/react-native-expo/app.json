{
  "expo": {
    "name": "react-native-expo",
    "slug": "react-native-expo",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "accept-a-payment",
    "ios": {
      "bundleIdentifier": "com.stripe.samples.acceptapayment",
      "supportsTablet": true
    },
    "android": {
      "package": "com.stripe.samples.acceptapayment",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    }
  }
}
